---
interface Props {
  locale: string;
}

const { locale } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-violet-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-sm">Y</span>
          </div>
          <span class="text-xl font-bold text-white">yoimagine</span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          Free online tools for PDF editing, SEO optimization, and career development. No sign-up required.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white mb-4">PDF Tools</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={`/${locale}/tools/compress-pdf/`} class="hover:text-indigo-400 transition-colors">Compress PDF</a></li>
          <li><a href={`/${locale}/tools/merge-pdf/`} class="hover:text-indigo-400 transition-colors">Merge PDF</a></li>
          <li><a href={`/${locale}/tools/split-pdf/`} class="hover:text-indigo-400 transition-colors">Split PDF</a></li>
          <li><a href={`/${locale}/tools/pdf-to-jpg/`} class="hover:text-indigo-400 transition-colors">PDF to JPG</a></li>
          <li><a href={`/${locale}/tools/jpg-to-pdf/`} class="hover:text-indigo-400 transition-colors">JPG to PDF</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white mb-4">SEO Tools</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={`/${locale}/tools/meta-title-generator/`} class="hover:text-indigo-400 transition-colors">Title Generator</a></li>
          <li><a href={`/${locale}/tools/schema-generator/`} class="hover:text-indigo-400 transition-colors">Schema Generator</a></li>
          <li><a href={`/${locale}/tools/keyword-density/`} class="hover:text-indigo-400 transition-colors">Keyword Density</a></li>
          <li><a href={`/${locale}/tools/serp-preview/`} class="hover:text-indigo-400 transition-colors">SERP Preview</a></li>
          <li><a href={`/${locale}/tools/og-preview/`} class="hover:text-indigo-400 transition-colors">OG Preview</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white mb-4">Career Tools</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={`/${locale}/tools/resume-builder/`} class="hover:text-indigo-400 transition-colors">Resume Builder</a></li>
          <li><a href={`/${locale}/tools/cover-letter/`} class="hover:text-indigo-400 transition-colors">Cover Letter</a></li>
          <li><a href={`/${locale}/tools/ats-checker/`} class="hover:text-indigo-400 transition-colors">ATS Checker</a></li>
          <li><a href={`/${locale}/tools/interview-questions/`} class="hover:text-indigo-400 transition-colors">Interview Prep</a></li>
          <li><a href={`/${locale}/blog/`} class="hover:text-indigo-400 transition-colors">Blog</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-800 mt-10 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-slate-500">
        &copy; {currentYear} yoimagine. All rights reserved. Built with Cloudflare.
      </p>
      <div class="flex gap-4 text-xs">
        <a href={`/${locale}/privacy/`} class="hover:text-indigo-400 transition-colors">Privacy Policy</a>
        <a href={`/${locale}/terms/`} class="hover:text-indigo-400 transition-colors">Terms of Service</a>
        <a href={`/${locale}/contact/`} class="hover:text-indigo-400 transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
