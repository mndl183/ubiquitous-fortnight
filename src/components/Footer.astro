---
import { getContentHref, t, type Locale } from '../utils/i18n.ts';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const lang = locale as Locale;

const currentYear = new Date().getFullYear();

const pdfTools = [
  { path: '/tools/compress-pdf/', key: 'toolsList.compress-pdf.name' },
  { path: '/tools/merge-pdf/', key: 'toolsList.merge-pdf.name' },
  { path: '/tools/split-pdf/', key: 'toolsList.split-pdf.name' },
  { path: '/tools/pdf-to-jpg/', key: 'toolsList.pdf-to-jpg.name' },
  { path: '/tools/jpg-to-pdf/', key: 'toolsList.jpg-to-pdf.name' },
  { path: '/tools/stl-viewer/', key: 'toolsList.stl-viewer.name' },
];

const seoTools = [
  { path: '/tools/meta-title-generator/', key: 'toolsList.meta-title-generator.name' },
  { path: '/tools/schema-generator/', key: 'toolsList.schema-generator.name' },
  { path: '/tools/keyword-density/', key: 'toolsList.keyword-density.name' },
  { path: '/tools/serp-preview/', key: 'toolsList.serp-preview.name' },
  { path: '/tools/og-preview/', key: 'toolsList.og-preview.name' },
];

const careerTools = [
  { path: '/tools/resume-builder/', key: 'toolsList.resume-builder.name' },
  { path: '/tools/cover-letter/', key: 'toolsList.cover-letter.name' },
  { path: '/tools/ats-checker/', key: 'toolsList.ats-checker.name' },
  { path: '/tools/interview-questions/', key: 'toolsList.interview-questions.name' },
  { path: '/blog/', key: 'nav.blog' },
];
---

<footer class="bg-slate-900 text-slate-400 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-violet-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-sm">Y</span>
          </div>
          <span class="text-xl font-bold text-white">yoimagine</span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          {t(lang, 'footer.description')}
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white mb-4">{t(lang, 'footer.pdfTools')}</h3>
        <ul class="space-y-2 text-sm">
          {pdfTools.map((tool) => (
            <li><a href={getContentHref(lang, tool.path)} class="hover:text-indigo-400 transition-colors">{t(lang, tool.key)}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white mb-4">{t(lang, 'footer.seoTools')}</h3>
        <ul class="space-y-2 text-sm">
          {seoTools.map((tool) => (
            <li><a href={getContentHref(lang, tool.path)} class="hover:text-indigo-400 transition-colors">{t(lang, tool.key)}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white mb-4">{t(lang, 'footer.careerTools')}</h3>
        <ul class="space-y-2 text-sm">
          {careerTools.map((tool) => (
            <li><a href={getContentHref(lang, tool.path)} class="hover:text-indigo-400 transition-colors">{t(lang, tool.key)}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-800 mt-10 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-slate-500">
        &copy; {currentYear} yoimagine. {t(lang, 'footer.allRights')}
      </p>
      <div class="flex gap-4 text-xs">
        <a href={getContentHref(lang, '/privacy/')} class="hover:text-indigo-400 transition-colors">{t(lang, 'footer.privacy')}</a>
        <a href={getContentHref(lang, '/terms/')} class="hover:text-indigo-400 transition-colors">{t(lang, 'footer.terms')}</a>
        <a href={getContentHref(lang, '/contact/')} class="hover:text-indigo-400 transition-colors">{t(lang, 'footer.contact')}</a>
      </div>
    </div>
  </div>
</footer>