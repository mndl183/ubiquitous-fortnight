---
interface Props {
  href: string;
  product: string;
  text?: string;
  variant?: 'primary' | 'secondary' | 'text';
  source?: string;
}

const {
  href,
  product,
  text = 'Learn More',
  variant = 'primary',
  source = 'affiliate',
} = Astro.props;

const trackingUrl = `${href}?utm_source=yoimagine&utm_medium=${source}&utm_campaign=${product}`;

const variants = {
  primary: 'bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold px-6 py-3 rounded-xl hover:shadow-lg hover:shadow-indigo-500/25 transition-all hover:-translate-y-0.5',
  secondary: 'border-2 border-indigo-500 text-indigo-600 font-semibold px-6 py-3 rounded-xl hover:bg-indigo-50 transition-all',
  text: 'text-indigo-600 font-medium underline underline-offset-4 hover:text-indigo-800 transition-colors',
};
---

<a
  href={trackingUrl}
  target="_blank"
  rel="noopener noreferrer nofollow sponsored"
  class={`inline-flex items-center gap-2 ${variants[variant]}`}
>
  {text}
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
  </svg>
</a>
