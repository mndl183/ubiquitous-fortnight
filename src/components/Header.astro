---
import { locales, localeNames } from '../utils/i18n.ts';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const navLinks = [
  { href: `/${locale}/tools/compress-pdf/`, label: 'PDF Tools' },
  { href: `/${locale}/tools/meta-title-generator/`, label: 'SEO Tools' },
  { href: `/${locale}/tools/resume-builder/`, label: 'Career Tools' },
  { href: `/${locale}/blog/`, label: 'Blog' },
];
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <a href={`/${locale}/`} class="flex items-center gap-2">
        <div class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-violet-600 rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-sm">Y</span>
        </div>
        <span class="text-xl font-bold bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent">yoimagine</span>
        <span class="hidden sm:inline text-sm font-medium text-slate-500 ml-1">Tools</span>
      </a>

      <nav class="hidden md:flex items-center gap-6">
        {navLinks.map((link) => (
          <a href={link.href} class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors">
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <div class="flex bg-slate-100 rounded-lg p-0.5">
          {locales.map((lang) => (
            <a
              href={`/${lang}/${Astro.url.pathname.split('/').slice(2).join('/')}`}
              class={`px-2.5 py-1 text-xs font-semibold rounded-md transition-colors ${
                locale === lang
                  ? 'bg-white text-indigo-600 shadow-sm'
                  : 'text-slate-500 hover:text-slate-700'
              }`}
            >
              {localeNames[lang]}
            </a>
          ))}
        </div>

        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 text-slate-600 hover:text-slate-900"
          aria-label="Toggle menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white">
    <div class="px-4 py-3 space-y-2">
      {navLinks.map((link) => (
        <a href={link.href} class="block text-sm font-medium text-slate-600 hover:text-indigo-600 py-2">
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
