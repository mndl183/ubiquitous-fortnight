---
interface Props {
  id: string;
  description?: string;
}

const { id, description = 'Upload your file to get started' } = Astro.props;
---

<div id={`tool-${id}`} class="tool-container">
  <div id={`dropzone-${id}`} class="border-2 border-dashed border-slate-300 rounded-2xl p-12 text-center hover:border-indigo-400 hover:bg-indigo-50/50 transition-all cursor-pointer relative">
    <input
      type="file"
      id={`file-input-${id}`}
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
      accept=".pdf"
    />
    <div class="pointer-events-none">
      <svg class="w-16 h-16 mx-auto text-slate-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
      </svg>
      <p class="text-lg font-semibold text-slate-700 mb-2">Drag & drop your PDF here</p>
      <p class="text-sm text-slate-500">or click to browse &bull; Max 50MB</p>
    </div>
  </div>

  <div id={`progress-${id}`} class="hidden mt-4">
    <div class="bg-slate-100 rounded-full h-2 overflow-hidden">
      <div id={`progress-bar-${id}`} class="bg-gradient-to-r from-indigo-500 to-violet-600 h-full transition-all duration-300" style="width: 0%"></div>
    </div>
    <p id={`status-${id}`} class="text-sm text-slate-500 mt-2 text-center">Processing...</p>
  </div>

  <div id={`result-${id}`} class="hidden mt-6 text-center">
    <div class="bg-green-50 border border-green-200 rounded-xl p-6">
      <svg class="w-12 h-12 mx-auto text-green-500 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <p class="font-semibold text-green-800 mb-4">Your file is ready!</p>
      <a
        id={`download-btn-${id}`}
        href="#"
        class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold px-6 py-3 rounded-xl hover:shadow-lg transition-all"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Download
      </a>
    </div>
  </div>

  <div id={`error-${id}`} class="hidden mt-6">
    <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
      <p class="font-semibold text-red-800">Something went wrong</p>
      <p id={`error-msg-${id}`} class="text-sm text-red-600 mt-1"></p>
    </div>
  </div>
</div>
