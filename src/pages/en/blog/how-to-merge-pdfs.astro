const title = 'How to Merge Multiple PDFs Online Free (2026)';
const description = 'Learn how to merge PDF files online for free. Combine multiple PDFs into one document instantly with no software download required.';
const publishDate = '2026-09-02';
const category = 'PDF Tools';
const relatedTools = [
  { href: '/en/tools/merge-pdf/', title: 'Merge PDF', description: 'Combine multiple PDFs' },
