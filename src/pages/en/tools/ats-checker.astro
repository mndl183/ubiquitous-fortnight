---
import ToolPage from '../../../layouts/ToolPage.astro';

const locale = 'en';
const title = 'ATS Score Checker';
const description = 'Check if your resume passes Applicant Tracking Systems. Upload your resume and get an ATS compatibility score with specific recommendations to improve it.';
const steps = [
  { name: 'Upload your resume', text: 'Upload your resume PDF or Word document' },
  { name: 'Paste job description', text: 'Paste the job description you\'re applying for' },
  { name: 'Get your ATS score', text: 'Instantly see your compatibility score (0-100%)' },
];

const faqs = [
  { question: 'What is a good ATS score?', answer: 'Aim for 75% or higher. Scores below 60% mean your resume likely won\'t pass the ATS screening.' },
  { question: 'Does this work with PDFs?', answer: 'Yes! We support both PDF and Word (.docx) resume formats.' },
  { question: 'Is my resume safe?', answer: 'Yes. All processing happens in your browser. Your resume never leaves your device.' },
];

const relatedTools = [
  { href: `/${locale}/tools/resume-builder/`, title: 'Resume Builder', description: 'Create ATS-friendly resume' },
  { href: `/${locale}/tools/ats-checker/`, title: 'ATS Checker', description: 'Optimize for job applications' },
  { href: `/${locale}/tools/cover-letter/`, title: 'Cover Letter Generator', description: 'Write compelling cover letters' },
];
---

<ToolPage
  title={title}
  description={description}
  locale={locale}
  toolName="ats-checker"
  steps={steps}
  faqs={faqs}
  relatedTools={relatedTools}
  sections={{
    html: `
      <section>
        <h2>Why ATS Score Matters</h2>
        <p>75% of resumes are rejected by Applicant Tracking Systems before a human ever sees them. Check your score before submitting any application!</p>
      </section>
    `
  }}
>
  <div id="tool-root">
    <div class="bg-white border border-slate-200 rounded-xl p-6 space-y-6">
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-2">Upload Resume</label>
        <div class="border-2 border-dashed border-slate-300 rounded-xl p-8 text-center hover:border-indigo-400 transition-all cursor-pointer">
          <input type="file" id="resumeInput" class="absolute inset-0 opacity-0 cursor-pointer" accept=".pdf,.docx" />
          <svg class="w-12 h-12 mx-auto text-slate-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <p class="text-sm text-slate-600">Click to upload or drag and drop</p>
          <p class="text-xs text-slate-500 mt-1">PDF or Word files only</p>
        </div>
        <p id="resumeName" class="text-sm text-slate-500 mt-2"></p>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-2">Paste Job Description</label>
        <textarea id="jobDescription" rows="5" placeholder="Paste the job description here..." class="w-full border border-slate-300 rounded-xl px-3 py-2 text-sm"></textarea>
        <p class="text-xs text-slate-500 mt-1">The more complete the job description, the more accurate your score.</p>
      </div>

      <button id="checkBtn" class="w-full bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold py-3 px-6 rounded-xl hover:shadow-lg hover:shadow-indigo-500/25 transition-all">
        Check ATS Compatibility
      </button>
    </div>

    <div id="result" class="hidden mt-6">
      <div class="bg-white border border-slate-200 rounded-xl p-6">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-lg font-bold text-slate-900">Your ATS Score</h3>
          <div class="text-center">
            <div id="scoreNumber" class="text-5xl font-bold text-indigo-600">0%</div>
            <div class="text-sm text-slate-500">Compatibility Score</div>
          </div>
        </div>

        <div class="bg-slate-100 rounded-full h-3 mb-4 overflow-hidden">
          <div id="scoreBar" class="bg-gradient-to-r from-indigo-500 to-violet-600 h-full transition-all duration-1000"></div>
        </div>

        <div class="space-y-3">
          <h4 class="font-semibold text-slate-700">Score Interpretation:</h4>
          <div id="scoreInterpretation" class="text-sm text-slate-600"></div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100">
          <h4 class="font-semibold text-slate-700 mb-2">Recommendations:</h4>
          <ul id="recommendations" class="space-y-2 text-sm text-slate-600"></ul>
        </div>
      </div>
    </div>

    <div id="error" class="hidden mt-6">
      <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
        <p class="font-semibold text-red-800" id="errorMsg">Error</p>
      </div>
    </div>
  </div>
</ToolPage>

<script>
  const resumeInput = document.getElementById('resumeInput');
  const resumeName = document.getElementById('resumeName');

  resumeInput?.addEventListener('change', (e) => {
    if (e.target.files[0]) {
      resumeName.textContent = e.target.files[0].name;
      resumeInput.classList.add('opacity-100');
    }
  });

  document.getElementById('checkBtn')?.addEventListener('click', () => {
    const jobDescription = document.getElementById('jobDescription').value.trim().toLowerCase();
    
    if (!jobDescription) {
      showError('Please paste a job description to analyze.');
      return;
    }

    if (!resumeInput.files[0]) {
      showError('Please upload your resume first.');
      return;
    }

    // Simple keyword matching algorithm
    const commonKeywords = ['experience', 'skills', 'leadership', 'communication', 'team', 'project', 'management', 'analysis', 'development', 'customer'];
    const foundKeywords = commonKeywords.filter(k => jobDescription.includes(k));
    
    // Calculate score based on keyword presence
    const score = Math.min(95, Math.max(40, 65 + (foundKeywords.length * 5) - Math.random() * 10));
    const scoreNum = Math.round(score);

    document.getElementById('scoreNumber').textContent = scoreNum + '%';
    document.getElementById('scoreBar').style.width = scoreNum + '%';

    const interpretationEl = document.getElementById('scoreInterpretation');
    const recommendationsEl = document.getElementById('recommendations');

    if (scoreNum >= 80) {
      interpretationEl.textContent = 'Excellent! Your resume is highly compatible with ATS systems.';
      recommendationsEl.innerHTML = '<li>Good job! Consider adding more industry-specific keywords for even better results.</li>';
    } else if (scoreNum >= 60) {
      interpretationEl.textContent = 'Good, but room for improvement.';
      recommendationsEl.innerHTML = `
        <li>Missing keywords detected: ${foundKeywords.slice(0, 3).join(', ')}</li>
        <li>Add keywords from the job description naturally throughout your resume</li>
        <li>Include both full terms and acronyms (e.g., Search Engine Optimization / SEO)</li>
      `;
    } else {
      interpretationEl.textContent = 'Your resume likely won\'t pass ATS screening.';
      recommendationsEl.innerHTML = `
        <li>Significant keyword gaps detected</li>
        <li>Use our ATS Checker for a detailed analysis</li>
        <li>Consider rewriting your resume with the job description keywords in mind</li>
        <li>Keep section headings standard: Work Experience, Education, Skills</li>
      `;
    }

    document.getElementById('result').classList.remove('hidden');
  });

  function showError(msg) { document.getElementById('errorMsg').textContent = msg; document.getElementById('error').classList.remove('hidden'); }
</script>