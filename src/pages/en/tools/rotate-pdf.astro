---
import ToolPage from '../../../layouts/ToolPage.astro';

const locale = 'en';
const title = 'Rotate PDF Pages';
const description = 'Rotate PDF pages 90°, 180°, or 270° online. Rotate all pages or specific pages in your PDF. Free, instant, no sign-up required.';

const steps = [
  { name: 'Upload your PDF', text: 'Drag and drop your PDF file into the upload area. Files up to 50MB supported.' },
  { name: 'Select rotation', text: 'Choose 90°, 180°, or 270° clockwise rotation for all pages.' },
  { name: 'Download rotated PDF', text: 'Download your PDF with all pages rotated to the correct orientation.' },
];

const faqs = [
  { question: 'Does rotation affect quality?', answer: 'No. Rotation is lossless - it only changes the page orientation metadata, not the content.' },
  { question: 'Can I rotate specific pages?', answer: 'Currently this tool rotates all pages. For specific pages, use our split tool first.' },
  { question: 'Does it work with scanned PDFs?', answer: 'Yes! Works perfectly with both text-based and scanned PDFs.' },
];

const relatedTools = [
  { href: `/${locale}/tools/compress-pdf/`, title: 'Compress PDF', description: 'Reduce file size after rotating' },
  { href: `/${locale}/tools/merge-pdf/`, title: 'Merge PDF', description: 'Combine multiple PDFs' },
  { href: `/${locale}/tools/split-pdf/`, title: 'Split PDF', description: 'Separate pages' },
];
---

<ToolPage title={title} description={description} locale={locale} toolName="rotate-pdf" steps={steps} faqs={faqs} relatedTools={relatedTools}>
  <div id="tool-root">
    <div id="dropzone" class="border-2 border-dashed border-slate-300 rounded-2xl p-8 sm:p-12 text-center hover:border-indigo-400 hover:bg-indigo-50/50 transition-all cursor-pointer relative">
      <input type="file" id="fileInput" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" accept=".pdf" />
      <div class="pointer-events-none">
        <svg class="w-16 h-16 mx-auto text-slate-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        <p class="text-lg font-semibold text-slate-700 mb-2">Drag &amp; drop your PDF here</p>
        <p class="text-sm text-slate-500">or click to browse &bull; Max 50MB</p>
      </div>
    </div>

    <div id="controls" class="hidden mt-6">
      <p class="text-sm font-semibold text-slate-700 mb-3">Select Rotation Angle</p>
      <div class="grid grid-cols-3 gap-3 mb-4">
        <button data-degrees="90" class="rotate-option border-2 border-indigo-500 bg-indigo-50 rounded-xl p-4 text-center">
          <div class="font-semibold text-indigo-700">90° CW</div>
        </button>
        <button data-degrees="180" class="rotate-option border-2 border-slate-200 rounded-xl p-4 text-center hover:border-indigo-300">
          <div class="font-semibold text-slate-900">180°</div>
        </button>
        <button data-degrees="270" class="rotate-option border-2 border-slate-200 rounded-xl p-4 text-center hover:border-indigo-300">
          <div class="font-semibold text-slate-900">270° CW</div>
        </button>
      </div>
      <button id="rotateBtn" class="w-full bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold py-3 px-6 rounded-xl hover:shadow-lg transition-all">Rotate PDF</button>
    </div>

    <div id="progress" class="hidden mt-6"><div class="bg-slate-100 rounded-full h-2"><div id="progressBar" class="bg-indigo-600 h-full transition-all" style="width: 0%"></div></div></div>

    <div id="result" class="hidden mt-6">
      <div class="bg-green-50 border border-green-200 rounded-xl p-6 text-center">
        <p class="font-semibold text-green-800 mb-4">PDF Rotated Successfully!</p>
        <button id="downloadBtn" class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold px-6 py-3 rounded-xl">Download Rotated PDF</button>
      </div>
    </div>

    <div id="error" class="hidden mt-6"><div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center"><p class="text-red-800" id="errorMsg"></p></div></div>
  </div>
</ToolPage>

<script>
  import { degrees, PDFDocument } from 'pdf-lib';
  let pdfDoc = null; let fileName = ''; let rotationDegrees = 90; let rotatedBytes = null;
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('fileInput');
  const controls = document.getElementById('controls');
  const progress = document.getElementById('progress');
  const progressBar = document.getElementById('progressBar');
  const result = document.getElementById('result');
  const error = document.getElementById('error');

  fileInput?.addEventListener('change', (e) => handleFile(e.target.files[0]));
  dropzone?.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('border-indigo-500'); });
  dropzone?.addEventListener('dragleave', () => dropzone.classList.remove('border-indigo-500'));
  dropzone?.addEventListener('drop', (e) => { e.preventDefault(); handleFile(e.dataTransfer.files[0]); });
  document.querySelectorAll('.rotate-option').forEach(btn => btn.addEventListener('click', () => {
    document.querySelectorAll('.rotate-option').forEach(b => { b.classList.remove('border-indigo-500', 'bg-indigo-50'); b.classList.add('border-slate-200'); });
    btn.classList.remove('border-slate-200'); btn.classList.add('border-indigo-500', 'bg-indigo-50'); rotationDegrees = parseInt(btn.dataset.degrees);
  }));
  document.getElementById('rotateBtn')?.addEventListener('click', rotatePdf);
  document.getElementById('downloadBtn')?.addEventListener('click', () => { if (!rotatedBytes) return; const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([rotatedBytes], { type: 'application/pdf' })); a.download = `${fileName}-rotated.pdf`; a.click(); });

  async function handleFile(file) {
    if (!file || !file.name.toLowerCase().endsWith('.pdf')) { showError('Please select a PDF file.'); return; }
    try { pdfDoc = await PDFDocument.load(await file.arrayBuffer()); fileName = file.name.replace('.pdf', ''); dropzone.classList.add('hidden'); controls.classList.remove('hidden'); } catch { showError('Could not open PDF.'); }
  }

  async function rotatePdf() {
    if (!pdfDoc) return;
    controls.classList.add('hidden'); progress.classList.remove('hidden');
    pdfDoc.getPages().forEach(page => page.setRotation(degrees(page.getRotation().angle + rotationDegrees)));
    rotatedBytes = await pdfDoc.save(); progressBar.style.width = '100%';
    await new Promise(r => setTimeout(r, 300)); progress.classList.add('hidden'); result.classList.remove('hidden');
  }

  function showError(msg) { document.getElementById('errorMsg').textContent = msg; error.classList.remove('hidden'); }
</script>