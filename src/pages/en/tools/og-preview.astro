---
import ToolPage from '../../../layouts/ToolPage.astro';

const locale = 'en';
const title = 'OG Image Preview Tool';
const description = 'Preview how your social media share cards appear on Facebook, Twitter, LinkedIn, and other platforms. Optimize your Open Graph images and titles.';
const steps = [
  { name: 'Enter your URL', text: 'Type your page URL (doesn\'t need to be live for preview)' },
  { name: 'Enter title', text: 'Enter your meta title for the preview' },
  { name: 'Enter description', text: 'Enter your meta description' },
  { name: 'View previews', text: 'See how your content appears on all major platforms' },
];

const faqs = [
  { question: 'What is an OG image?', answer: 'Open Graph images are the preview images shown when you share a link on Facebook, LinkedIn, and other social platforms.' },
  { question: 'What size should OG images be?', answer: 'Recommended size is 1200x630 pixels for best results across all platforms. Our tool helps you preview at this size.' },
  { question: 'Does this work for Twitter?', answer: 'Yes! We show both standard Open Graph (used by LinkedIn, WhatsApp, etc.) and Twitter Card previews.' },
];

const relatedTools = [
  { href: `/${locale}/tools/meta-title-generator/`, title: 'Title Generator', description: 'Create SEO-optimized titles' },
  { href: `/${locale}/tools/schema-generator/`, title: 'Schema Generator', description: 'Create structured data' },
  { href: `/${locale}/tools/serp-preview/`, title: 'SERP Preview', description: 'Preview Google search results' },
];
---

<ToolPage
  title={title}
  description={description}
  locale={locale}
  toolName="og-preview"
  steps={steps}
  faqs={faqs}
  relatedTools={relatedTools}
  sections={{
    html: `
      <section>
        <h2>Why OG Image Preview Matters</h2>
        <p>When people share your content on social media, your OG image is the first thing they see. A compelling image with clear text can dramatically increase engagement.</p>
      </section>
    `
  }}
>
  <div id="tool-root">
    <div class="bg-white border border-slate-200 rounded-xl p-6 space-y-4">
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Page URL</label>
        <input type="text" id="pageUrl" placeholder="https://example.com/your-page" class="w-full border border-slate-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500" value="https://example.com" />
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Title</label>
        <input type="text" id="metaTitle" placeholder="Your Page Title" class="w-full border border-slate-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500" value="Your Page Title" />
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Description</label>
        <textarea id="metaDescription" placeholder="Your page description appears here..." rows="2" class="w-full border border-slate-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500">Your page description appears here...</textarea>
      </div>
    </div>

    <div class="mt-6 space-y-6">
      <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
        <div class="bg-slate-100 px-4 py-3 border-b border-slate-200">
          <h3 class="text-sm font-bold text-slate-700 flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
            Facebook Preview
          </h3>
        </div>
        <div class="p-4">
          <div class="flex items-start gap-3">
            <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center shrink-0">
              <span class="text-indigo-600 font-bold text-xs">YO</span>
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-bold text-slate-900 text-sm">yoimagine Tools</span>
                <span class="text-slate-400 text-xs">• 2h</span>
              </div>
              <p class="text-slate-700 text-sm mb-2">Check out this amazing tool! <span class="text-[#1a0dab] text-xs underline">https://example.com</span></p>
              <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
                <div class="h-48 bg-slate-100 flex items-center justify-center">
                  <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                </div>
                <div class="p-3">
                  <div class="font-semibold text-slate-900 text-sm truncate" id="fbTitle">Your Page Title</div>
                  <p class="text-slate-500 text-xs truncate" id="fbDescription">Your page description appears here...</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
        <div class="bg-slate-100 px-4 py-3 border-b border-slate-200">
          <h3 class="text-sm font-bold text-slate-700 flex items-center gap-2">
            <svg class="w-5 h-5 text-sky-500" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
            X (Twitter) Preview
          </h3>
        </div>
        <div class="p-4">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-sky-100 rounded-full flex items-center justify-center shrink-0">
              <span class="text-sky-600 font-bold text-xs">YO</span>
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-bold text-slate-900 text-sm">yoimagine Tools</span>
                <span class="text-slate-400 text-xs">@yoimagine</span>
              </div>
              <p class="text-slate-800 text-sm mb-2 leading-relaxed">
                Your page description appears here... <span class="text-[#1d9bf0] text-xs">https://example.com</span>
              </p>
              <div class="rounded-lg overflow-hidden border border-slate-200">
                <div class="h-48 bg-slate-100 flex items-center justify-center">
                  <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                </div>
                <div class="px-2 py-2 border-t border-slate-200">
                  <div class="font-semibold text-slate-900 text-xs truncate" id="twitterTitle">Your Page Title</div>
                  <p class="text-slate-500 text-xs truncate" id="twitterDescription">Your page description appears here...</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
        <div class="bg-slate-100 px-4 py-3 border-b border-slate-200">
          <h3 class="text-sm font-bold text-slate-700 flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-700" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            LinkedIn Preview
          </h3>
        </div>
        <div class="p-4">
          <div class="flex items-start gap-3">
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center shrink-0">
              <span class="text-blue-700 font-bold text-xs">YO</span>
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-bold text-slate-900 text-sm">yoimagine Tools</span>
                <span class="text-slate-400 text-xs">yoimagine.com</span>
              </div>
              <p class="text-slate-700 text-sm mb-2">Your page description appears here...</p>
              <div class="border border-slate-200 rounded-lg overflow-hidden">
                <div class="h-48 bg-slate-100 flex items-center justify-center">
                  <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                </div>
                <div class="p-3">
                  <div class="font-semibold text-slate-900 text-sm truncate" id="linkedinTitle">Your Page Title</div>
                  <p class="text-slate-500 text-xs truncate" id="linkedinDescription">Your page description appears here...</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</ToolPage>

<script>
  const metaTitle = document.getElementById('metaTitle');
  const metaDescription = document.getElementById('metaDescription');

  metaTitle?.addEventListener('input', () => {
    document.getElementById('fbTitle').textContent = metaTitle.value;
    document.getElementById('twitterTitle').textContent = metaTitle.value;
    document.getElementById('linkedinTitle').textContent = metaTitle.value;
  });

  metaDescription?.addEventListener('input', () => {
    document.getElementById('fbDescription').textContent = metaDescription.value;
    document.getElementById('twitterDescription').textContent = metaDescription.value;
    document.getElementById('linkedinDescription').textContent = metaDescription.value;
  });
</script>