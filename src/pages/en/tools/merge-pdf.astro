---
import ToolPage from '../../../layouts/ToolPage.astro';

const locale = 'en';
const title = 'Merge PDF';
const description = 'Free online PDF merger to combine multiple PDF files into one document. Merge PDFs instantly in your browser. No sign-up, no watermarks.';

const steps = [
  { name: 'Upload multiple PDFs', text: 'Drag and drop multiple PDF files into the upload area, or click to browse and select files. You can add up to 20 PDFs at once.' },
  { name: 'Arrange the order', text: 'Drag files to reorder them. The top file will appear first in your merged document.' },
  { name: 'Download merged PDF', text: 'Click "Merge PDFs" to combine them, then download your single merged document instantly.' },
];

const faqs = [
  { question: 'Can I merge password-protected PDFs?', answer: 'No, you must remove the password protection first using our Remove PDF Password tool, then merge the unlocked files.' },
  { question: 'Is there a limit on how many PDFs I can merge?', answer: 'You can merge up to 20 PDF files at once, with a combined total size of 100MB. For larger batches, consider Adobe Acrobat Pro.' },
  { question: 'Will merging reduce PDF quality?', answer: 'No. Merging preserves the original quality of all documents. Text, images, and formatting remain exactly as they were.' },
  { question: 'Can I rearrange pages after merging?', answer: 'Currently, you need to merge in the desired order. For advanced page rearrangement, use Adobe Acrobat or similar software.' },
  { question: 'Is my data secure?', answer: 'Yes. All processing happens in your browser using JavaScript. Your files never leave your device.' },
  { question: 'Can I merge PDFs on mobile?', answer: 'Absolutely! Our merger works on iPhones, Android phones, tablets, and any device with a modern web browser.' },
];

const relatedTools = [
  { href: `/${locale}/tools/split-pdf/`, title: 'Split PDF', description: 'Separate a PDF into individual pages' },
  { href: `/${locale}/tools/compress-pdf/`, title: 'Compress PDF', description: 'Reduce file size before merging' },
  { href: `/${locale}/tools/extract-pages/`, title: 'Extract Pages', description: 'Pull specific pages from a PDF' },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: title,
  description,
  step: steps.map((step, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: step.name,
    text: step.text,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<ToolPage
  title={title}
  description={description}
  locale={locale}
  toolName="merge-pdf"
  steps={steps}
  faqs={faqs}
  relatedTools={relatedTools}
  schemas={[howToSchema, faqSchema]}
  sections={{
    html: `
      <section>
        <h2>What is PDF Merging?</h2>
        <p>PDF merging combines multiple PDF documents into a single file. This is useful for combining related documents, creating comprehensive reports, or organizing scattered files into one cohesive document.</p>
        <p>Our free online PDF merger works entirely in your browser, preserving document quality while making file management effortless.</p>
      </section>
      <section>
        <h2>Common Use Cases for Merging PDFs</h2>
        <ul>
          <li><strong>Business reports:</strong> Combine monthly statements, charts, and analysis into one document</li>
          <li><strong>Legal documents:</strong> Merge contracts, addendums, and supporting materials</li>
          <li><strong>Academic work:</strong> Combine research papers, bibliographies, and appendices</li>
          <li><strong>Job applications:</strong> Merge resume, cover letter, and portfolio pieces</li>
          <li><strong>Presentations:</strong> Combine slide decks and handout materials</li>
        </ul>
      </section>
      <section>
        <h2>Tips for Merging PDFs</h2>
        <ol>
          <li><strong>Check file order:</strong> Files are merged in the order you add them. Drag to reorder before merging.</li>
          <li><strong>Compress first:</strong> If files are large, compress them before merging to stay under email size limits.</li>
          <li><strong>Verify content:</strong> Preview each file before merging to ensure you're combining the right documents.</li>
          <li><strong>Remove passwords:</strong> Password-protected PDFs must be unlocked before merging.</li>
        </ol>
      </section>
    `
  }}
>
  <div id="tool-root">
    <div id="dropzone" class="border-2 border-dashed border-slate-300 rounded-2xl p-8 sm:p-12 text-center hover:border-indigo-400 hover:bg-indigo-50/50 transition-all cursor-pointer relative">
      <input type="file" id="fileInput" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" accept=".pdf" multiple />
      <div class="pointer-events-none">
        <svg class="w-16 h-16 mx-auto text-slate-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <p class="text-lg font-semibold text-slate-700 mb-2">Drag &amp; drop multiple PDFs here</p>
        <p class="text-sm text-slate-500">or click to browse &bull; Up to 20 files &bull; Max 100MB total</p>
      </div>
    </div>

    <div id="fileList" class="hidden mt-6 space-y-2"></div>

    <div id="progress" class="hidden mt-6">
      <div class="bg-slate-100 rounded-full h-2 overflow-hidden">
        <div id="progressBar" class="bg-gradient-to-r from-indigo-500 to-violet-600 h-full transition-all duration-300" style="width: 0%"></div>
      </div>
      <p id="status" class="text-sm text-slate-500 mt-2 text-center">Merging PDFs...</p>
    </div>

    <div id="result" class="hidden mt-6">
      <div class="bg-green-50 border border-green-200 rounded-xl p-6 text-center">
        <svg class="w-12 h-12 mx-auto text-green-500 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="font-semibold text-green-800 mb-4">PDFs Merged Successfully!</p>
        <button id="downloadBtn" class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold px-6 py-3 rounded-xl hover:shadow-lg transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download Merged PDF
        </button>
      </div>
    </div>

    <div id="error" class="hidden mt-6">
      <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
        <p class="font-semibold text-red-800">Something went wrong</p>
        <p id="errorMsg" class="text-sm text-red-600 mt-1"></p>
      </div>
    </div>
  </div>
</ToolPage>

<script>
  import { PDFDocument } from 'pdf-lib';

  let files = [];
  let mergedBytes = null;

  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('fileInput');
  const fileList = document.getElementById('fileList');
  const progress = document.getElementById('progress');
  const result = document.getElementById('result');
  const error = document.getElementById('error');
  const progressBar = document.getElementById('progressBar');
  const status = document.getElementById('status');
  const errorMsg = document.getElementById('errorMsg');
  const downloadBtn = document.getElementById('downloadBtn');

  fileInput?.addEventListener('change', (e) => handleFiles(e.target.files));

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-indigo-500', 'bg-indigo-50');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-indigo-500', 'bg-indigo-50');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-indigo-500', 'bg-indigo-50');
    handleFiles(e.dataTransfer.files);
  });

  downloadBtn?.addEventListener('click', () => downloadMerged());

  function handleFiles(inputFiles) {
    const newFiles = Array.from(inputFiles).filter(f => f.name.toLowerCase().endsWith('.pdf'));

    if (files.length + newFiles.length > 20) {
      showError('Maximum 20 files allowed.');
      return;
    }

    const totalSize = files.reduce((sum, f) => sum + f.size, 0) + newFiles.reduce((sum, f) => sum + f.size, 0);
    if (totalSize > 100 * 1024 * 1024) {
      showError('Total file size exceeds 100MB limit.');
      return;
    }

    files = [...files, ...newFiles];
    renderFileList();
  }

  function renderFileList() {
    if (files.length === 0) {
      fileList.classList.add('hidden');
      return;
    }

    fileList.classList.remove('hidden');
    fileList.innerHTML = '';

    files.forEach((file, index) => {
      const item = document.createElement('div');
      item.className = 'flex items-center justify-between bg-white border border-slate-200 rounded-xl px-4 py-3';
      item.innerHTML = `
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <div>
            <p class="text-sm font-medium text-slate-900">${file.name}</p>
            <p class="text-xs text-slate-500">${(file.size / 1024).toFixed(1)} KB</p>
          </div>
        </div>
        <button class="text-slate-400 hover:text-red-500 transition-colors p-1" data-index="${index}">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      `;
      fileList.appendChild(item);
    });

    fileList.querySelectorAll('button[data-index]').forEach(btn => {
      btn.addEventListener('click', () => {
        const index = parseInt(btn.dataset.index);
        files.splice(index, 1);
        renderFileList();
      });
    });

    const mergeBtn = document.createElement('button');
    mergeBtn.textContent = 'Merge PDFs';
    mergeBtn.className = 'w-full mt-4 bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold py-3 px-6 rounded-xl hover:shadow-lg hover:shadow-indigo-500/25 transition-all';
    mergeBtn.addEventListener('click', mergePdfs);
    fileList.appendChild(mergeBtn);
  }

  async function mergePdfs() {
    if (files.length < 2) {
      showError('Please add at least 2 PDF files to merge.');
      return;
    }

    fileList.classList.add('hidden');
    progress.classList.remove('hidden');
    progressBar.style.width = '10%';
    status.textContent = 'Reading files...';

    try {
      const mergedPdf = await PDFDocument.create();

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const arrayBuffer = await file.arrayBuffer();
        const pdf = await PDFDocument.load(arrayBuffer);
        const pages = await mergedPdf.copyPages(pdf, pdf.getPageIndices());
        pages.forEach(page => mergedPdf.addPage(page));
        progressBar.style.width = `${10 + (i + 1) / files.length * 70}%`;
      }

      status.textContent = 'Generating merged PDF...';
      mergedBytes = await mergedPdf.save();
      progressBar.style.width = '100%';

      await new Promise(resolve => setTimeout(resolve, 300));
      progress.classList.add('hidden');
      result.classList.remove('hidden');
    } catch (err) {
      console.error(err);
      showError('Could not merge PDFs. One or more files may be corrupted or password-protected.');
    }
  }

  function downloadMerged() {
    if (!mergedBytes) return;
    const blob = new Blob([mergedBytes], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'merged.pdf';
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  function showError(message) {
    errorMsg.textContent = message;
    error.classList.remove('hidden');
    result.classList.add('hidden');
    progress.classList.add('hidden');
  }
</script>
