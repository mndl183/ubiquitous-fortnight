---
import ToolPage from '../../../layouts/ToolPage.astro';

const locale = 'en';
const title = 'PDF to JPG';
const description = 'Convert PDF to JPG images online. Extract all pages or specific pages from your PDF as high-quality JPG images. Free, fast, and secure.';

const steps = [
  { name: 'Upload your PDF', text: 'Drag and drop your PDF file into the upload area. Files up to 50MB supported.' },
  { name: 'Select pages to convert', text: 'Choose to convert all pages or enter specific page numbers (e.g., 1,3,5).' },
  { name: 'Download JPG images', text: 'Download individual JPG images or all as a ZIP file.' },
];

const faqs = [
  { question: 'Is PDF to JPG conversion free?', answer: 'Yes, completely free. No watermarks, no sign-up required. We use client-side processing so your files never leave your device.' },
  { question: 'What image quality can I expect?', answer: 'Our converter produces high-quality JPG images at 300 DPI, suitable for printing and professional use.' },
  { question: 'Can I convert specific pages only?', answer: 'Yes. After uploading, enter the page numbers you want to convert (e.g., 1,3,5 or 1-5).' },
  { question: 'Will my PDF formatting be preserved?', answer: 'Each PDF page becomes one JPG image. Layout, fonts, and images are preserved as they appear in the original.' },
  { question: 'Is there a file size limit?', answer: 'Free version supports PDFs up to 50MB. For larger files, consider Adobe Acrobat or professional conversion services.' },
];

const relatedTools = [
  { href: `/${locale}/tools/jpg-to-pdf/`, title: 'JPG to PDF', description: 'Convert JPG images to PDF' },
  { href: `/${locale}/tools/compress-pdf/`, title: 'Compress PDF', description: 'Reduce PDF file size' },
  { href: `/${locale}/tools/extract-pages/`, title: 'Extract Pages', description: 'Extract specific pages' },
];
---

<ToolPage title={title} description={description} locale={locale} toolName="pdf-to-jpg" steps={steps} faqs={faqs} relatedTools={relatedTools}>
  <div id="tool-root">
    <div id="dropzone" class="border-2 border-dashed border-slate-300 rounded-2xl p-8 sm:p-12 text-center hover:border-indigo-400 hover:bg-indigo-50/50 transition-all cursor-pointer relative">
      <input type="file" id="fileInput" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" accept=".pdf" />
      <div class="pointer-events-none">
        <svg class="w-16 h-16 mx-auto text-slate-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <p class="text-lg font-semibold text-slate-700 mb-2">Drag &amp; drop your PDF here</p>
        <p class="text-sm text-slate-500">or click to browse &bull; Max 50MB</p>
      </div>
    </div>

    <div id="controls" class="hidden mt-6 p-6 bg-white border border-slate-200 rounded-xl">
      <p id="fileInfo" class="text-sm text-slate-600 mb-4"></p>
      <div class="flex flex-col sm:flex-row gap-3 mb-4">
        <input type="text" id="pageRange" placeholder="Leave empty for all pages, or enter: 1,3,5 or 1-5" class="flex-1 border border-slate-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        <button id="convertBtn" class="bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold px-6 py-3 rounded-xl hover:shadow-lg transition-all">
          Convert to JPG
        </button>
      </div>
    </div>

    <div id="progress" class="hidden mt-6">
      <div class="bg-slate-100 rounded-full h-2 overflow-hidden"><div id="progressBar" class="bg-gradient-to-r from-indigo-500 to-violet-600 h-full transition-all" style="width: 0%"></div></div>
      <p id="status" class="text-sm text-slate-500 mt-2 text-center">Converting...</p>
    </div>

    <div id="result" class="hidden mt-6">
      <div class="bg-green-50 border border-green-200 rounded-xl p-6">
        <div class="text-center mb-4"><p class="font-semibold text-green-800">Conversion Complete!</p></div>
        <div id="imageGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-4"></div>
        <div class="text-center">
          <button id="downloadAll" class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold px-6 py-3 rounded-xl hover:shadow-lg transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            Download All as ZIP
          </button>
        </div>
      </div>
    </div>

    <div id="error" class="hidden mt-6">
      <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
        <p class="font-semibold text-red-800">Error</p>
        <p id="errorMsg" class="text-sm text-red-600 mt-1"></p>
      </div>
    </div>
  </div>
</ToolPage>

<script>
  let pdfDoc = null; let fileName = ''; let images = [];
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('fileInput');
  const controls = document.getElementById('controls');
  const fileInfo = document.getElementById('fileInfo');
  const progress = document.getElementById('progress');
  const progressBar = document.getElementById('progressBar');
  const status = document.getElementById('status');
  const result = document.getElementById('result');
  const error = document.getElementById('error');
  const errorMsg = document.getElementById('errorMsg');
  const imageGrid = document.getElementById('imageGrid');

  fileInput?.addEventListener('change', (e) => handleFile(e.target.files[0]));
  dropzone?.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('border-indigo-500', 'bg-indigo-50'); });
  dropzone?.addEventListener('dragleave', () => dropzone.classList.remove('border-indigo-500', 'bg-indigo-50'));
  dropzone?.addEventListener('drop', (e) => { e.preventDefault(); dropzone.classList.remove('border-indigo-500', 'bg-indigo-50'); handleFile(e.dataTransfer.files[0]); });
  document.getElementById('convertBtn')?.addEventListener('click', convertToJpg);

  async function handleFile(file) {
    if (!file || !file.name.toLowerCase().endsWith('.pdf')) { showError('Please select a PDF file.'); return; }
    try {
      const arrayBuffer = await file.arrayBuffer();
      const pdfjsLib = await import('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.mjs');
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.mjs';
      pdfDoc = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
      fileName = file.name.replace('.pdf', '');
      fileInfo.textContent = `Loaded: ${file.name} (${pdfDoc.numPages} pages)`;
      dropzone.classList.add('hidden');
      controls.classList.remove('hidden');
    } catch (err) { showError('Could not open PDF. It may be corrupted or password-protected.'); }
  }

  async function convertToJpg() {
    if (!pdfDoc) return;
    controls.classList.add('hidden'); progress.classList.remove('hidden'); images = []; imageGrid.innerHTML = '';
    const input = document.getElementById('pageRange').value.trim();
    let pages = input ? (input.includes('-') ? (() => { const [s, e] = input.split('-').map(Number); return Array.from({length: e - s + 1}, (_, i) => s + i - 1); })() : input.split(',').map(n => parseInt(n) - 1)) : Array.from({length: pdfDoc.numPages}, (_, i) => i);
    pages = pages.filter(p => p >= 0 && p < pdfDoc.numPages);
    
    try {
      const pdfjsLib = await import('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.mjs');
      for (let i = 0; i < pages.length; i++) {
        const pageNum = pages[i] + 1; status.textContent = `Converting page ${i + 1} of ${pages.length}...`;
        const page = await pdfDoc.getPage(pageNum); const viewport = page.getViewport({ scale: 2 });
        const canvas = document.createElement('canvas'); canvas.width = viewport.width; canvas.height = viewport.height;
        await page.render({ canvasContext: canvas.getContext('2d'), viewport }).promise;
        const blob = await new Promise(r => canvas.toBlob(r, 'image/jpeg', 0.95)); images.push({ blob, name: `${fileName}-page-${pageNum}.jpg` });
        progressBar.style.width = `${((i + 1) / pages.length) * 100}%`;
      }
      progress.classList.add('hidden'); result.classList.remove('hidden');
      images.forEach((img, idx) => {
        const div = document.createElement('div'); div.className = 'text-center';
        div.innerHTML = `<img src="${URL.createObjectURL(img.blob)}" class="w-full rounded-lg mb-2" /><a href="${URL.createObjectURL(img.blob)}" download="${img.name}" class="text-xs text-indigo-600 hover:underline">Download</a>`;
        imageGrid.appendChild(div);
      });
      document.getElementById('downloadAll')?.addEventListener('click', downloadZip);
    } catch (err) { showError('Conversion failed. Please try a different PDF.'); }
  }

  async function downloadZip() {
    if (images.length === 0) return;
    const zip = new JSZip(); images.forEach(img => zip.file(img.name, img.blob));
    const content = await zip.generateAsync({ type: 'blob' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(content); a.download = `${fileName}-images.zip`; a.click();
  }

  function showError(msg) { errorMsg.textContent = msg; error.classList.remove('hidden'); progress.classList.add('hidden'); }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>