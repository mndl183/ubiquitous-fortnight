---
import ToolPage from '../../../layouts/ToolPage.astro';

const locale = 'en';
const title = 'Split PDF';
const description = 'Free online PDF splitter to separate a PDF into individual pages or extract specific page ranges. Split PDF files instantly in your browser. No sign-up required.';

const steps = [
  { name: 'Upload your PDF', text: 'Drag and drop your PDF file into the upload area. Files up to 50MB are supported.' },
  { name: 'Choose split mode', text: 'Select "Split all pages" to separate every page, or "Extract range" to split specific pages.' },
  { name: 'Download split files', text: 'Download individual pages as separate PDFs, or download all as a ZIP archive.' },
];

const faqs = [
  { question: 'What is PDF splitting?', answer: 'PDF splitting separates a multi-page PDF document into individual pages or extracts specific page ranges. This is useful when you only need certain pages from a larger document.' },
  { question: 'Can I split password-protected PDFs?', answer: 'No, you must remove the password first using our Remove PDF Password tool, then split the unlocked file.' },
  { question: 'Is there a page limit?', answer: 'You can split PDFs with up to 500 pages. For larger documents, consider professional PDF software like Adobe Acrobat.' },
  { question: 'Will splitting affect PDF quality?', answer: 'No. Splitting preserves the original quality of each page. Text, images, and formatting remain exactly as they were.' },
  { question: 'Can I split scanned PDFs?', answer: 'Yes! Our splitter works with both text-based and scanned PDFs without any issues.' },
];

const relatedTools = [
  { href: `/${locale}/tools/merge-pdf/`, title: 'Merge PDF', description: 'Combine multiple PDFs into one' },
  { href: `/${locale}/tools/extract-pages/`, title: 'Extract Pages', description: 'Pull specific pages from a PDF' },
  { href: `/${locale}/tools/compress-pdf/`, title: 'Compress PDF', description: 'Reduce file size after splitting' },
];
---

<ToolPage
  title={title}
  description={description}
  locale={locale}
  toolName="split-pdf"
  steps={steps}
  faqs={faqs}
  relatedTools={relatedTools}
  sections={{
    html: `
      <section>
        <h2>What is PDF Splitting?</h2>
        <p>PDF splitting separates a multi-page PDF into individual pages or smaller documents. This is useful for extracting specific content, reducing file sizes for email, or organizing large documents into manageable sections.</p>
      </section>
      <section>
        <h2>Common Use Cases for Splitting PDFs</h2>
        <ul>
          <li><strong>Extract one page:</strong> Pull a single invoice or receipt from a multi-page statement</li>
          <li><strong>Share specific sections:</strong> Send only relevant pages instead of entire documents</li>
          <li><strong>Reduce email attachments:</strong> Split large PDFs to meet email size limits</li>
          <li><strong>Archive individual pages:</strong> Organize documents by page for easier retrieval</li>
        </ul>
      </section>
    `
  }}
>
  <div id="tool-root">
    <div id="dropzone" class="border-2 border-dashed border-slate-300 rounded-2xl p-8 sm:p-12 text-center hover:border-indigo-400 hover:bg-indigo-50/50 transition-all cursor-pointer relative">
      <input type="file" id="fileInput" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" accept=".pdf" />
      <div class="pointer-events-none">
        <svg class="w-16 h-16 mx-auto text-slate-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
        </svg>
        <p class="text-lg font-semibold text-slate-700 mb-2">Drag &amp; drop your PDF here</p>
        <p class="text-sm text-slate-500">or click to browse &bull; Max 50MB &bull; Up to 500 pages</p>
      </div>
    </div>

    <div id="controls" class="hidden mt-6">
      <p id="fileInfo" class="text-sm text-slate-600 mb-4"></p>

      <div class="space-y-4">
        <button id="splitAll" class="w-full border-2 border-indigo-500 text-indigo-600 font-semibold py-3 px-6 rounded-xl hover:bg-indigo-50 transition-all">
          Split All Pages (create separate PDF for each page)
        </button>

        <div class="text-center text-sm text-slate-500">or</div>

        <div class="flex gap-3">
          <input type="text" id="pageRange" placeholder="e.g., 1-5 or 1,3,7" class="flex-1 border border-slate-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          <button id="extractRange" class="bg-indigo-100 text-indigo-700 font-semibold px-6 py-3 rounded-xl hover:bg-indigo-200 transition-all">
            Extract Pages
          </button>
        </div>
      </div>
    </div>

    <div id="progress" class="hidden mt-6">
      <div class="bg-slate-100 rounded-full h-2 overflow-hidden">
        <div id="progressBar" class="bg-gradient-to-r from-indigo-500 to-violet-600 h-full transition-all duration-300" style="width: 0%"></div>
      </div>
      <p id="status" class="text-sm text-slate-500 mt-2 text-center">Splitting PDF...</p>
    </div>

    <div id="result" class="hidden mt-6">
      <div class="bg-green-50 border border-green-200 rounded-xl p-6 text-center">
        <svg class="w-12 h-12 mx-auto text-green-500 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="font-semibold text-green-800 mb-4">PDF Split Successfully!</p>
        <div id="downloadLinks" class="space-y-2"></div>
      </div>
    </div>

    <div id="error" class="hidden mt-6">
      <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
        <p class="font-semibold text-red-800">Something went wrong</p>
        <p id="errorMsg" class="text-sm text-red-600 mt-1"></p>
      </div>
    </div>
  </div>
</ToolPage>

<script>
  import { PDFDocument } from 'pdf-lib';

  let pdfDoc = null;
  let fileName = '';

  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('fileInput');
  const controls = document.getElementById('controls');
  const fileInfo = document.getElementById('fileInfo');
  const progress = document.getElementById('progress');
  const result = document.getElementById('result');
  const error = document.getElementById('error');
  const progressBar = document.getElementById('progressBar');
  const status = document.getElementById('status');
  const errorMsg = document.getElementById('errorMsg');
  const downloadLinks = document.getElementById('downloadLinks');

  fileInput?.addEventListener('change', (e) => handleFile(e.target.files[0]));

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-indigo-500', 'bg-indigo-50');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-indigo-500', 'bg-indigo-50');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-indigo-500', 'bg-indigo-50');
    handleFile(e.dataTransfer.files[0]);
  });

  document.getElementById('splitAll')?.addEventListener('click', () => splitAllPages());
  document.getElementById('extractRange')?.addEventListener('click', () => extractRange());

  async function handleFile(file) {
    if (!file || !file.name.toLowerCase().endsWith('.pdf')) {
      showError('Please select a valid PDF file.');
      return;
    }

    if (file.size > 50 * 1024 * 1024) {
      showError('File is too large. Maximum size is 50MB.');
      return;
    }

    try {
      const arrayBuffer = await file.arrayBuffer();
      pdfDoc = await PDFDocument.load(arrayBuffer);
      fileName = file.name.replace('.pdf', '');

      const pageCount = pdfDoc.getPageCount();
      fileInfo.textContent = `Loaded: ${file.name} (${pageCount} pages)`;
      dropzone.classList.add('hidden');
      controls.classList.remove('hidden');
    } catch (err) {
      showError('Could not open this PDF. It may be corrupted or password-protected.');
    }
  }

  async function splitAllPages() {
    if (!pdfDoc) return;

    controls.classList.add('hidden');
    progress.classList.remove('hidden');

    const pageCount = pdfDoc.getPageCount();
    const pages = [];

    for (let i = 0; i < pageCount; i++) {
      const newPdf = await PDFDocument.create();
      const [page] = await newPdf.copyPages(pdfDoc, [i]);
      newPdf.addPage(page);
      const bytes = await newPdf.save();
      pages.push({ bytes, name: `${fileName}-page-${i + 1}.pdf` });
      progressBar.style.width = `${((i + 1) / pageCount) * 100}%`;
    }

    progress.classList.add('hidden');
    result.classList.remove('hidden');

    downloadLinks.innerHTML = '';
    pages.forEach((page, index) => {
      if (index < 10 || pageCount <= 10) {
        const btn = document.createElement('a');
        btn.href = URL.createObjectURL(new Blob([page.bytes], { type: 'application/pdf' }));
        btn.download = page.name;
        btn.className = 'block w-full text-center bg-white border border-slate-300 rounded-lg px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors';
        btn.textContent = page.name;
        downloadLinks.appendChild(btn);
      }
    });

    if (pageCount > 10) {
      const note = document.createElement('p');
      note.className = 'text-xs text-slate-500 mt-2';
      note.textContent = `Showing first 10 of ${pageCount} pages. All pages are ready for download.`;
      downloadLinks.insertBefore(note, downloadLinks.firstChild);
    }
  }

  async function extractRange() {
    const input = document.getElementById('pageRange').value.trim();
    if (!input) {
      showError('Please enter page numbers (e.g., 1-5 or 1,3,7)');
      return;
    }

    let pageNumbers = [];
    if (input.includes('-')) {
      const [start, end] = input.split('-').map(n => parseInt(n.trim()));
      for (let i = start; i <= end; i++) pageNumbers.push(i - 1);
    } else {
      pageNumbers = input.split(',').map(n => parseInt(n.trim()) - 1);
    }

    const pageCount = pdfDoc.getPageCount();
    if (pageNumbers.some(n => n < 0 || n >= pageCount)) {
      showError(`Invalid page numbers. Document has ${pageCount} pages.`);
      return;
    }

    controls.classList.add('hidden');
    progress.classList.remove('hidden');
    progressBar.style.width = '50%';

    const newPdf = await PDFDocument.create();
    const pages = await newPdf.copyPages(pdfDoc, pageNumbers);
    pages.forEach(page => newPdf.addPage(page));

    const bytes = await newPdf.save();
    progressBar.style.width = '100%';

    progress.classList.add('hidden');
    result.classList.remove('hidden');

    downloadLinks.innerHTML = '';
    const btn = document.createElement('a');
    btn.href = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
    btn.download = `${fileName}-extracted.pdf`;
    btn.className = 'inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold px-6 py-3 rounded-xl hover:shadow-lg transition-all';
    btn.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg> Download Extracted Pages`;
    downloadLinks.appendChild(btn);
  }

  function showError(message) {
    errorMsg.textContent = message;
    error.classList.remove('hidden');
    result.classList.add('hidden');
    progress.classList.add('hidden');
  }
</script>
