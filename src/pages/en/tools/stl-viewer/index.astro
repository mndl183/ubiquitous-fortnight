---
import Base from '../../../../layouts/Base.astro';

const locale = 'en';
const pageTitle = 'STL Viewer & Model Manager';
const pageDescription = 'Free online STL viewer with a built-in model library. Upload multiple STL files or whole folders, preview them in 3D, and add descriptions and tags. No sign-up required.';
---

<Base title={pageTitle} description={pageDescription} locale={locale}>
  <div class="bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <nav class="text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/en/" class="hover:text-indigo-600">Home</a></li>
          <li class="text-slate-300">/</li>
          <li><a href="/en/tools/" class="hover:text-indigo-600">Tools</a></li>
          <li class="text-slate-300">/</li>
          <li class="text-slate-700 font-medium">STL Viewer</li>
        </ol>
      </nav>

      <header class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-indigo-500 to-violet-600 rounded-2xl mb-4 shadow-lg shadow-indigo-500/20">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight">STL Viewer &amp; Model Manager</h1>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
          View 3D printed models in your browser. Upload multiple files or entire folders, get instant previews, and organize them with descriptions and tags. Everything stays on your device.
        </p>
      </header>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sm:p-6 mb-8">
        <div class="flex flex-col lg:flex-row lg:items-center gap-4 justify-between">
          <div class="flex items-center gap-3 min-w-0">
            <span class="w-10 h-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </span>
            <div class="min-w-0">
              <p id="tool-status" class="text-sm text-slate-600 font-medium truncate">Load up to start organizing your models.</p>
              <p class="text-xs text-slate-400 mt-0.5">Models are stored and processed entirely in your browser.</p>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-2 shrink-0">
            <label class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold px-5 py-2.5 rounded-xl hover:shadow-lg transition-all cursor-pointer text-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M8 9l4-4 4 4m-4-4v8" /></svg>
              Upload Files
              <input id="file-input" type="file" accept=".stl" multiple class="hidden" />
            </label>
            <label class="inline-flex items-center justify-center gap-2 border-2 border-indigo-200 text-indigo-700 font-semibold px-5 py-2.5 rounded-xl hover:border-indigo-400 hover:bg-indigo-50 transition-all cursor-pointer text-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19a2 2 0 01-2-2V7a2 2 0 012-2h4l2 2h4a2 2 0 012 2v1M5 19h14a2 2 0 002-2v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5a2 2 0 01-2 2z" /></svg>
              Upload Folder
              <input id="dir-input" type="file" accept=".stl" multiple webkitdirectory directory class="hidden" />
            </label>
          </div>
        </div>

        <div class="mt-4">
          <input
            id="search-input"
            type="search"
            placeholder="Search models by name, description, or tag..."
            class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
          />
        </div>
      </div>

      <div id="gallery" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>

      <div id="gallery-empty" class="hidden text-center py-16">
        <div class="w-14 h-14 bg-slate-100 text-slate-400 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <p class="font-semibold text-slate-700">No models found</p>
        <p class="text-sm text-slate-500 mt-1">Try a different search, or upload STL files or a folder above.</p>
      </div>

      <section class="bg-white rounded-2xl border border-slate-200 p-8 mt-10">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">How to Use the STL Model Manager</h2>
        <ol class="space-y-4">
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 bg-indigo-100 text-indigo-700 rounded-full flex items-center justify-center font-bold text-sm mt-0.5">1</span>
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">Upload models</h3>
              <p class="text-slate-600 text-sm sm:text-base">Use "Upload Files" to select many STL files at once, or "Upload Folder" to pick a whole folder (including subfolders) and upload every model in it. You can also drag and drop files onto the grid.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 bg-indigo-100 text-indigo-700 rounded-full flex items-center justify-center font-bold text-sm mt-0.5">2</span>
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">Preview instantly</h3>
              <p class="text-slate-600 text-sm sm:text-base">Every model gets a 3D thumbnail preview. Click "Open viewer" to inspect it in full detail — drag to rotate, scroll to zoom, right-click drag to pan. All rendering happens in your browser.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 bg-indigo-100 text-indigo-700 rounded-full flex items-center justify-center font-bold text-sm mt-0.5">3</span>
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">Organize with descriptions and tags</h3>
              <p class="text-slate-600 text-sm sm:text-base">Open a model and add a name, description, and comma-separated tags. Changes are saved to your browser and stick between visits. Search by name, description, or tag at any time.</p>
            </div>
          </li>
        </ol>
      </section>
    </div>
  </div>

  <div id="viewer-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/70">
    <div class="bg-white rounded-2xl shadow-2xl max-w-5xl w-full max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100">
        <h2 id="modal-title" class="font-bold text-slate-900">Model Viewer</h2>
        <button id="close-modal" class="p-2 text-slate-500 hover:text-slate-800 transition-colors" aria-label="Close viewer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <div id="model-viewer" class="w-full h-[320px] sm:h-[440px] bg-slate-100"></div>
          <div class="px-4 py-3 bg-slate-50 border-t border-slate-100 text-xs text-slate-500">
            Drag to rotate &bull; Scroll to zoom &bull; Right-click drag to pan
          </div>
        </div>
        <div class="lg:col-span-2 border-t lg:border-t-0 lg:border-l border-slate-100 p-5">
          <div class="space-y-4">
            <div>
              <label for="model-name" class="block text-xs font-semibold text-slate-600 mb-1">Name</label>
              <input id="model-name" type="text" class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
            </div>
            <div>
              <label for="model-desc" class="block text-xs font-semibold text-slate-600 mb-1">Description</label>
              <textarea id="model-desc" rows="4" class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"></textarea>
            </div>
            <div>
              <label for="model-tags" class="block text-xs font-semibold text-slate-600 mb-1">Tags</label>
              <input id="model-tags" type="text" placeholder="mechanical, prototype, v2" class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
              <p class="text-xs text-slate-400 mt-1">Separate tags with commas.</p>
            </div>
          </div>
          <p id="modal-hint" class="text-xs text-slate-500 mt-4"></p>
          <div class="flex flex-wrap gap-2 mt-4">
            <button id="save-model" class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold px-4 py-2 rounded-xl text-sm hover:shadow-lg transition-all">
              Save
            </button>
            <a id="modal-download" href="/models/cube.stl" class="inline-flex items-center gap-2 border-2 border-slate-200 text-slate-700 font-semibold px-4 py-2 rounded-xl text-sm hover:border-indigo-400 hover:text-indigo-600 transition-all">
              Download STL
            </a>
            <button id="delete-model" class="inline-flex items-center gap-2 text-red-600 hover:text-red-800 font-semibold px-3 py-2 rounded-xl text-sm transition-colors">
              Delete
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { initStlApp } from '../../../../utils/stlApp.ts';
  initStlApp();
</script>