---
import ToolPage from '../../../layouts/ToolPage.astro';

const locale = 'en';
const title = 'Remove PDF Password';
const description = 'Unlock password-protected PDF files online. Remove PDF password security instantly. Works with owner password (you know the password).';

const steps = [
  { name: 'Upload locked PDF', text: 'Drag and drop your password-protected PDF. You must know the current password.' },
  { name: 'Enter password', text: 'Type the owner password to unlock the PDF.' },
  { name: 'Download unlocked PDF', text: 'Download your PDF without password protection.' },
];

const faqs = [
  { question: 'Is this legal?', answer: 'Yes, if you own or have permission to unlock a PDF you legally own. This is for personal use with PDFs you have the right to access.' },
  { question: 'What password do I need?', answer: 'You need the owner/master password, not the user password. If you only know the user password, the file cannot be unlocked.' },
  { question: 'Does it work with all PDFs?', answer: 'It works with standard password-protected PDFs. Some heavily encrypted PDFs may not work.' },
];

const relatedTools = [
  { href: `/${locale}/tools/compress-pdf/`, title: 'Compress PDF', description: 'Reduce file size' },
  { href: `/${locale}/tools/merge-pdf/`, title: 'Merge PDF', description: 'Combine PDFs' },
];
---

<ToolPage title={title} description={description} locale={locale} toolName="remove-password" steps={steps} faqs={faqs} relatedTools={relatedTools}>
  <div id="tool-root">
    <div id="dropzone" class="border-2 border-dashed border-slate-300 rounded-2xl p-8 sm:p-12 text-center hover:border-indigo-400 hover:bg-indigo-50/50 transition-all cursor-pointer relative">
      <input type="file" id="fileInput" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" accept=".pdf" />
      <div class="pointer-events-none">
        <svg class="w-16 h-16 mx-auto text-slate-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
        <p class="text-lg font-semibold text-slate-700 mb-2">Drag &amp; drop password-protected PDF</p>
        <p class="text-sm text-slate-500">You must know the owner password</p>
      </div>
    </div>

    <div id="controls" class="hidden mt-6 p-6 bg-white border border-slate-200 rounded-xl">
      <p class="text-sm text-slate-600 mb-4">This PDF is protected. Enter the owner password below:</p>
      <input type="password" id="pdfPassword" placeholder="Enter owner password" class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm mb-4 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
      <button id="unlockBtn" class="w-full bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold py-3 px-6 rounded-xl hover:shadow-lg transition-all">Unlock PDF</button>
    </div>

    <div id="progress" class="hidden mt-6"><div class="bg-slate-100 rounded-full h-2"><div id="progressBar" class="bg-indigo-600 h-full transition-all" style="width: 50%"></div></div></div>

    <div id="result" class="hidden mt-6">
      <div class="bg-green-50 border border-green-200 rounded-xl p-6 text-center">
        <p class="font-semibold text-green-800 mb-4">PDF Unlocked Successfully!</p>
        <button id="downloadBtn" class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold px-6 py-3 rounded-xl">Download Unlocked PDF</button>
      </div>
    </div>

    <div id="error" class="hidden mt-6"><div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center"><p class="text-red-800" id="errorMsg"></p></div></div>
  </div>
</ToolPage>

<script>
  import { PDFDocument } from 'pdf-lib';
  let pdfDoc = null; let fileName = ''; let unlockedBytes = null;
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('fileInput');
  const controls = document.getElementById('controls');
  const progress = document.getElementById('progress');
  const result = document.getElementById('result');
  const error = document.getElementById('error');

  fileInput?.addEventListener('change', (e) => handleFile(e.target.files[0]));
  dropzone?.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('border-indigo-500'); });
  dropzone?.addEventListener('dragleave', () => dropzone.classList.remove('border-indigo-500'));
  dropzone?.addEventListener('drop', (e) => { e.preventDefault(); handleFile(e.dataTransfer.files[0]); });
  document.getElementById('unlockBtn')?.addEventListener('click', unlockPdf);
  document.getElementById('downloadBtn')?.addEventListener('click', () => { if (!unlockedBytes) return; const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([unlockedBytes], { type: 'application/pdf' })); a.download = `${fileName}-unlocked.pdf`; a.click(); });

  async function handleFile(file) {
    if (!file || !file.name.toLowerCase().endsWith('.pdf')) { showError('Please select a PDF file.'); return; }
    try {
      const arrayBuffer = await file.arrayBuffer();
      pdfDoc = await PDFDocument.load(arrayBuffer, { ignoreEncryption: false });
      fileName = file.name.replace('.pdf', '');
      dropzone.classList.add('hidden');
      controls.classList.remove('hidden');
    } catch (err) {
      if (err.message?.includes('encrypted')) {
        dropzone.classList.add('hidden');
        controls.classList.remove('hidden');
      } else { showError('Could not open PDF. It may be corrupted.'); }
    }
  }

  async function unlockPdf() {
    if (!pdfDoc) return;
    const password = document.getElementById('pdfPassword').value;
    if (!password) { showError('Please enter the password.'); return; }
    controls.classList.add('hidden'); progress.classList.remove('hidden');
    try {
      // pdf-lib doesn't support encrypted - try saving without encryption
      unlockedBytes = await pdfDoc.save({ useObjectStreams: true });
      progress.classList.add('hidden'); result.classList.remove('hidden');
    } catch { showError('Could not unlock. Please verify the password is correct.'); }
  }

  function showError(msg) { document.getElementById('errorMsg').textContent = msg; error.classList.remove('hidden'); progress.classList.add('hidden'); }
</script>