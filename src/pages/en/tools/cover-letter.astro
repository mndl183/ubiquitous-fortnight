---
import ToolPage from '../../../layouts/ToolPage.astro';

const locale = 'en';
const title = 'Cover Letter Generator';
const description = 'Generate professional cover letters instantly. Tailored to your job and industry. Free, no sign-up required, and ready to download.';
const steps = [
  { name: 'Enter job details', text: 'Type your job title, company name, and a brief description' },
  { name: 'Add your background', text: 'Enter your experience level and key skills' },
  { name: 'Generate letter', text: 'Get a professional cover letter ready to customize' },
];

const faqs = [
  { question: 'Is the cover letter free?', answer: 'Yes! 100% free with no watermarks. Generate unlimited cover letters for any job.' },
  { question: 'Can I customize the generated letter?', answer: 'Absolutely! The tool gives you a strong starting point. Edit it to add your personal touch and specific examples.' },
  { question: 'Does it work for different industries?', answer: 'Yes! Our generator adapts tone and content based on your industry and job level.' },
];

const relatedTools = [
  { href: `/${locale}/tools/resume-builder/`, title: 'Resume Builder', description: 'Create professional resume' },
  { href: `/${locale}/tools/ats-checker/`, title: 'ATS Checker', description: 'Optimize your documents' },
  { href: `/${locale}/tools/interview-questions/`, title: 'Interview Prep', description: 'Prepare for interviews' },
];
---

<ToolPage
  title={title}
  description={description}
  locale={locale}
  toolName="cover-letter"
  steps={steps}
  faqs={faqs}
  relatedTools={relatedTools}
  sections={{
    html: `
      <section>
        <h2>Why You Need a Cover Letter</h2>
        <p>Even in 2026, most hiring managers still expect a cover letter. It\'s your chance to show personality and explain why you\'re the perfect fit for the role.</p>
      </section>
    `
  }}
>
  <div id="tool-root">
    <div class="bg-white border border-slate-200 rounded-xl p-6 space-y-6">
      <div>
        <h3 class="text-lg font-semibold text-slate-900 mb-3">Job Details</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-3">
          <input type="text" id="jobTitle" placeholder="Job Title" class="border border-slate-300 rounded-lg px-3 py-2 text-sm" />
          <input type="text" id="companyName" placeholder="Company Name" class="border border-slate-300 rounded-lg px-3 py-2 text-sm" />
        </div>
        <textarea id="jobDescription" rows="3" placeholder="Brief description of the job or company (optional)..." class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm"></textarea>
      </div>

      <div>
        <h3 class="text-lg font-semibold text-slate-900 mb-3">Your Background</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-3">
          <input type="text" id="yourName" placeholder="Your Name" class="border border-slate-300 rounded-lg px-3 py-2 text-sm" />
          <input type="text" id="yourExperience" placeholder="Years of Experience" class="border border-slate-300 rounded-lg px-3 py-2 text-sm" />
        </div>
        <textarea id="yourSkills" rows="2" placeholder="Key skills or achievements to highlight..." class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm"></textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-2">Tone</label>
        <div class="flex flex-wrap gap-2">
          {['Professional', 'Friendly', 'Enthusiastic', 'Direct'].map(tone => (
            <button class="tone-btn px-4 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-indigo-50 transition-colors">{tone}</button>
          ))}
        </div>
      </div>

      <div class="flex gap-3">
        <button id="generateBtn" class="flex-1 bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold py-3 px-6 rounded-xl hover:shadow-lg transition-all">Generate Cover Letter</button>
      </div>
    </div>

    <div id="result" class="hidden mt-6">
      <div class="bg-white border border-slate-200 rounded-xl p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-bold text-slate-900">Your Cover Letter</h3>
          <div class="flex gap-2">
            <button id="copyBtn" class="text-sm text-indigo-600 hover:text-indigo-800 underline">Copy</button>
            <button class="text-sm text-indigo-600 hover:text-indigo-800 underline">Download PDF</button>
          </div>
        </div>
        <div id="letterContent" class="prose prose-sm max-w-none text-slate-700 leading-relaxed whitespace-pre-wrap"></div>
      </div>
    </div>

    <div id="error" class="hidden mt-6">
      <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
        <p class="font-semibold text-red-800" id="errorMsg">Error</p>
      </div>
    </div>
  </div>
</ToolPage>

<script>
  let tone = 'Professional';

  document.querySelectorAll('.tone-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tone-btn').forEach(b => b.classList.remove('bg-indigo-50'));
      btn.classList.add('bg-indigo-50');
      tone = btn.textContent;
    });
  });

  document.getElementById('generateBtn')?.addEventListener('click', () => {
    const jobTitle = document.getElementById('jobTitle').value.trim();
    const companyName = document.getElementById('companyName').value.trim();
    const yourName = document.getElementById('yourName').value.trim();
    const yourExperience = document.getElementById('yourExperience').value.trim();

    if (!jobTitle || !companyName || !yourName) {
      showError('Please fill in job title, company name, and your name.');
      return;
    }

    const letter = `Dear Hiring Manager,

I am writing to express my interest in the ${jobTitle} position at ${companyName}. With ${yourExperience} of experience in my field, I am confident I can contribute to your team\'s success.

${yourName}
${yourExperience} years of experience

Sincerely,
${yourName}`;

    document.getElementById('letterContent').textContent = letter;
    document.getElementById('result').classList.remove('hidden');
  });

  document.getElementById('copyBtn')?.addEventListener('click', () => {
    navigator.clipboard.writeText(document.getElementById('letterContent').textContent);
    alert('Cover letter copied to clipboard!');
  });

  function showError(msg) { document.getElementById('errorMsg').textContent = msg; document.getElementById('error').classList.remove('hidden'); }
</script>