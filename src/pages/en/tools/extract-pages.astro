---
import ToolPage from '../../../layouts/ToolPage.astro';

const locale = 'en';
const title = 'Extract PDF Pages';
const description = 'Extract specific pages from PDF online. Select pages to pull out and save as a new PDF. Free, fast, and secure.';

const steps = [
  { name: 'Upload your PDF', text: 'Drag and drop your PDF file into the upload area.' },
  { name: 'Select pages to extract', text: 'Enter page numbers like 1,3,5 or 1-3 to extract specific pages.' },
  { name: 'Download extracted pages', text: 'Download the selected pages as a new PDF file.' },
];

const faqs = [
  { question: 'How do I specify which pages?', answer: 'Enter page numbers separated by commas (1,3,5) or ranges (1-5). Page 1 is the first page.' },
  { question: 'Can I extract many pages at once?', answer: 'Yes, you can extract any number of pages up to the total pages in your PDF.' },
];

const relatedTools = [
  { href: `/${locale}/tools/split-pdf/`, title: 'Split PDF', description: 'Split all pages into separate files' },
  { href: `/${locale}/tools/merge-pdf/`, title: 'Merge PDF', description: 'Combine extracted pages with others' },
];
---

<ToolPage title={title} description={description} locale={locale} toolName="extract-pages" steps={steps} faqs={faqs} relatedTools={relatedTools}>
  <div id="tool-root">
    <div id="dropzone" class="border-2 border-dashed border-slate-300 rounded-2xl p-8 sm:p-12 text-center hover:border-indigo-400 hover:bg-indigo-50/50 transition-all cursor-pointer relative">
      <input type="file" id="fileInput" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" accept=".pdf" />
      <div class="pointer-events-none">
        <svg class="w-16 h-16 mx-auto text-slate-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" /></svg>
        <p class="text-lg font-semibold text-slate-700 mb-2">Drag &amp; drop your PDF here</p>
        <p class="text-sm text-slate-500">Max 50MB</p>
      </div>
    </div>

    <div id="controls" class="hidden mt-6 p-6 bg-white border border-slate-200 rounded-xl">
      <p id="fileInfo" class="text-sm text-slate-600 mb-4"></p>
      <input type="text" id="pageRange" placeholder="e.g., 1,3,5 or 1-5 or 1-10" class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm mb-4 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
      <button id="extractBtn" class="w-full bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold py-3 px-6 rounded-xl hover:shadow-lg transition-all">Extract Pages</button>
    </div>

    <div id="progress" class="hidden mt-6"><div class="bg-slate-100 rounded-full h-2"><div id="progressBar" class="bg-indigo-600 h-full transition-all" style="width: 50%"></div></div></div>

    <div id="result" class="hidden mt-6">
      <div class="bg-green-50 border border-green-200 rounded-xl p-6 text-center">
        <p class="font-semibold text-green-800 mb-4">Pages Extracted Successfully!</p>
        <button id="downloadBtn" class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-violet-600 text-white font-semibold px-6 py-3 rounded-xl">Download Extracted PDF</button>
      </div>
    </div>

    <div id="error" class="hidden mt-6"><div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center"><p class="text-red-800" id="errorMsg"></p></div></div>
  </div>
</ToolPage>

<script>
  import { PDFDocument } from 'pdf-lib';
  let pdfDoc = null; let fileName = ''; let extractedBytes = null;
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('fileInput');
  const controls = document.getElementById('controls');
  const fileInfo = document.getElementById('fileInfo');
  const progress = document.getElementById('progress');
  const result = document.getElementById('result');
  const error = document.getElementById('error');

  fileInput?.addEventListener('change', (e) => handleFile(e.target.files[0]));
  dropzone?.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('border-indigo-500'); });
  dropzone?.addEventListener('dragleave', () => dropzone.classList.remove('border-indigo-500'));
  dropzone?.addEventListener('drop', (e) => { e.preventDefault(); handleFile(e.dataTransfer.files[0]); });
  document.getElementById('extractBtn')?.addEventListener('click', extractPages);
  document.getElementById('downloadBtn')?.addEventListener('click', () => { if (!extractedBytes) return; const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([extractedBytes], { type: 'application/pdf' })); a.download = `${fileName}-extracted.pdf`; a.click(); });

  async function handleFile(file) {
    if (!file || !file.name.toLowerCase().endsWith('.pdf')) { showError('Please select a PDF file.'); return; }
    try {
      pdfDoc = await PDFDocument.load(await file.arrayBuffer());
      fileName = file.name.replace('.pdf', '');
      fileInfo.textContent = `Loaded: ${file.name} (${pdfDoc.getPageCount()} pages)`;
      dropzone.classList.add('hidden');
      controls.classList.remove('hidden');
    } catch { showError('Could not open PDF.'); }
  }

  async function extractPages() {
    if (!pdfDoc) return;
    const input = document.getElementById('pageRange').value.trim();
    if (!input) { showError('Please enter page numbers to extract.'); return; }
    let pages = [];
    if (input.includes('-')) { const [s, e] = input.split('-').map(Number); for (let i = s; i <= e; i++) pages.push(i - 1); }
    else pages = input.split(',').map(n => parseInt(n) - 1);
    pages = pages.filter(p => p >= 0 && p < pdfDoc.getPageCount());
    if (pages.length === 0) { showError('Invalid page numbers.'); return; }
    controls.classList.add('hidden'); progress.classList.remove('hidden');
    try {
      const newPdf = await PDFDocument.create();
      const copied = await newPdf.copyPages(pdfDoc, pages);
      copied.forEach(page => newPdf.addPage(page));
      extractedBytes = await newPdf.save();
      progress.classList.add('hidden'); result.classList.remove('hidden');
    } catch { showError('Could not extract pages.'); }
  }

  function showError(msg) { document.getElementById('errorMsg').textContent = msg; error.classList.remove('hidden'); progress.classList.add('hidden'); }
</script>