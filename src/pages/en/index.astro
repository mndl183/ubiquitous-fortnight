---
import Base from '../../layouts/Base.astro';
import AdSenseBlock from '../../components/AdSenseBlock.astro';

const locale = 'en';

const toolCategories = [
  {
    title: 'PDF Tools',
    icon: 'pdf',
    description: 'Edit, convert, merge, and compress your PDF files instantly.',
    tools: [
      { href: `/${locale}/tools/compress-pdf/`, name: 'Compress PDF', description: 'Reduce PDF file size without losing quality' },
      { href: `/${locale}/tools/merge-pdf/`, name: 'Merge PDF', description: 'Combine multiple PDF files into one' },
      { href: `/${locale}/tools/split-pdf/`, name: 'Split PDF', description: 'Separate pages from a PDF document' },
      { href: `/${locale}/tools/pdf-to-jpg/`, name: 'PDF to JPG', description: 'Convert PDF pages to JPG images' },
      { href: `/${locale}/tools/jpg-to-pdf/`, name: 'JPG to PDF', description: 'Convert JPG images to PDF format' },
      { href: `/${locale}/tools/rotate-pdf/`, name: 'Rotate PDF', description: 'Rotate PDF pages to any orientation' },
      { href: `/${locale}/tools/remove-password/`, name: 'Remove PDF Password', description: 'Unlock password-protected PDF files' },
      { href: `/${locale}/tools/extract-pages/`, name: 'Extract Pages', description: 'Extract specific pages from a PDF' },
    ],
  },
  {
    title: 'SEO Tools',
    icon: 'seo',
    description: 'Optimize your content for search engines with free online tools.',
    tools: [
      { href: `/${locale}/tools/meta-title-generator/`, name: 'Title & Meta Generator', description: 'Generate SEO-optimized titles and descriptions' },
      { href: `/${locale}/tools/schema-generator/`, name: 'Schema Markup Generator', description: 'Create JSON-LD structured data' },
      { href: `/${locale}/tools/keyword-density/`, name: 'Keyword Density Checker', description: 'Analyze keyword usage in your content' },
      { href: `/${locale}/tools/serp-preview/`, name: 'SERP Preview', description: 'See how your page looks in Google search' },
      { href: `/${locale}/tools/og-preview/`, name: 'OG Image Preview', description: 'Preview your social media share cards' },
    ],
  },
  {
    title: 'Career Tools',
    icon: 'career',
    description: 'Build your resume, write cover letters, and ace interviews.',
    tools: [
      { href: `/${locale}/tools/resume-builder/`, name: 'Resume Builder', description: 'Create a professional resume from templates' },
      { href: `/${locale}/tools/cover-letter/`, name: 'Cover Letter Generator', description: 'Generate tailored cover letters' },
      { href: `/${locale}/tools/ats-checker/`, name: 'ATS Score Checker', description: 'Check how your resume performs against ATS' },
      { href: `/${locale}/tools/interview-questions/`, name: 'Interview Prep', description: 'Generate interview questions for your role' },
    ],
  },
];
---

<Base
  title="Free Online PDF, SEO & Career Tools"
  description="Free online tools for compressing PDFs, generating SEO content, and building professional resumes. No sign-up required. Fast, secure, and mobile-friendly."
  locale={locale}
>
  <section class="bg-gradient-to-br from-indigo-600 via-indigo-700 to-violet-700 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-24 text-center">
      <span class="inline-block bg-white/10 text-white/90 text-xs font-semibold px-4 py-1.5 rounded-full mb-6 backdrop-blur-sm border border-white/20">
        100% Free &bull; No Sign-up &bull; Secure &bull; Mobile-Friendly
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold mb-6 tracking-tight leading-tight">
        Free Online Tools for<br />Modern Professionals
      </h1>
      <p class="text-lg sm:text-xl text-indigo-100 max-w-2xl mx-auto leading-relaxed mb-10">
        Compress PDFs, generate SEO content, and build career documents — all in your browser. No file uploads to our servers.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-3">
        <a href={`/${locale}/tools/compress-pdf/`} class="bg-white text-indigo-700 font-semibold px-8 py-4 rounded-xl hover:bg-indigo-50 transition-all shadow-lg">
          Start Compressing PDFs
        </a>
        <a href={`/${locale}/tools/resume-builder/`} class="border-2 border-white/30 text-white font-semibold px-8 py-4 rounded-xl hover:bg-white/10 transition-all">
          Build Your Resume
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <AdSenseBlock slotId="HOMEPAGE_TOP" format="horizontal" className="mb-12" />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {toolCategories.map((category) => (
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg hover:border-indigo-200 transition-all">
          <div class="bg-gradient-to-r from-indigo-50 to-violet-50 px-6 py-5 border-b border-slate-100">
            <h2 class="text-xl font-bold text-slate-900 mb-1">{category.title}</h2>
            <p class="text-sm text-slate-500">{category.description}</p>
          </div>
          <ul class="divide-y divide-slate-100">
            {category.tools.map((tool) => (
              <li>
                <a
                  href={tool.href}
                  class="block px-6 py-4 hover:bg-indigo-50/50 transition-colors group"
                >
                  <p class="font-semibold text-slate-900 group-hover:text-indigo-600 transition-colors text-sm">
                    {tool.name}
                  </p>
                  <p class="text-xs text-slate-500 mt-0.5">{tool.description}</p>
                </a>
              </li>
            ))}
          </ul>
          <div class="px-6 py-3 bg-slate-50 text-center">
            <a href={`/${locale}/tools/`} class="text-sm font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">
              View all {category.title} &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-slate-50 border-y border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
      <h2 class="text-3xl font-bold text-slate-900 text-center mb-4">Why Choose yoimagine Tools?</h2>
      <p class="text-slate-500 text-center max-w-2xl mx-auto mb-12">Built with privacy and speed in mind. Your files stay in your browser.</p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-14 h-14 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="font-bold text-slate-900 mb-2">100% Private</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Files are processed entirely in your browser. Nothing is uploaded to our servers.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-bold text-slate-900 mb-2">Instant Results</h3>
          <p class="text-sm text-slate-500 leading-relaxed">No waiting. Tools process files in real-time using modern web technologies.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 bg-violet-100 text-violet-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-bold text-slate-900 mb-2">Mobile Ready</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Works perfectly on phones, tablets, and desktops. Use anywhere, anytime.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <AdSenseBlock slotId="HOMEPAGE_BOTTOM" format="horizontal" />
  </section>
</Base>
