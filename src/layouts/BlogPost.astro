---
import Base from './Base.astro';
import AdSenseBlock from '../components/AdSenseBlock.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { getContentHref, type Locale } from '../utils/i18n.ts';

interface Props {
  title: string;
  description: string;
  author?: string;
  publishDate?: string;
  updatedDate?: string;
  locale?: string;
  category?: string;
  relatedTools?: { href: string; title: string; description: string }[];
  relatedPosts?: { href: string; title: string }[];
}

const {
  title,
  description,
  author = 'yoimagine Team',
  publishDate = new Date().toISOString(),
  updatedDate,
  locale = 'en',
  category = '',
  relatedTools = [],
  relatedPosts = [],
} = Astro.props;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  author: {
    '@type': 'Organization',
    name: 'yoimagine',
  },
  datePublished: publishDate,
  dateModified: updatedDate || publishDate,
  publisher: {
    '@type': 'Organization',
    name: 'yoimagine',
  },
  mainEntityOfPage: `https://tools.yoimagine.com/${locale}/blog/`,
  inLanguage: locale,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://tools.yoimagine.com/${locale}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `https://tools.yoimagine.com/${locale}/blog/` },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};

const formatDate = (iso: string) => new Date(iso).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base
  title={title}
  description={description}
  locale={locale}
  schemas={[articleSchema, breadcrumbSchema]}
>
  <div class="bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
      <nav class="text-sm text-slate-500 mb-4" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={getContentHref(locale as Locale, '/')} class="hover:text-indigo-600">Home</a></li>
          <li class="text-slate-300">/</li>
          <li><a href={getContentHref(locale as Locale, '/blog/')} class="hover:text-indigo-600">Blog</a></li>
          <li class="text-slate-300">/</li>
          <li class="text-slate-700 font-medium truncate max-w-[200px]">{title}</li>
        </ol>
      </nav>

      <header class="mb-8">
        {category && (
          <span class="inline-block bg-indigo-100 text-indigo-700 text-xs font-semibold px-3 py-1 rounded-full mb-3">
            {category}
          </span>
        )}
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 leading-tight tracking-tight mb-4">
          {title}
        </h1>
        <div class="flex items-center gap-4 text-sm text-slate-500">
          <span class="font-medium text-slate-700">{author}</span>
          <span class="text-slate-300">&bull;</span>
          <time datetime={publishDate}>{formatDate(publishDate)}</time>
          {updatedDate && updatedDate !== publishDate && (
            <>
              <span class="text-slate-300">&bull;</span>
              <span>Updated {formatDate(updatedDate)}</span>
            </>
          )}
        </div>
      </header>

      <AdSenseBlock slotId="ARTICLE_TOP" format="horizontal" className="mb-8" />

      <article class="prose prose-lg prose-indigo max-w-none text-slate-700 leading-relaxed">
        <slot />
      </article>

      <AdSenseBlock slotId="ARTICLE_MIDDLE" format="auto" className="my-8" />

      <div class="mt-10 pt-8 border-t border-slate-200">
        <div class="flex flex-wrap gap-3 items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-gradient-to-br from-indigo-500 to-violet-600 rounded-full flex items-center justify-center">
              <span class="text-white font-bold text-sm">Y</span>
            </div>
            <div>
              <p class="font-semibold text-slate-900 text-sm">{author}</p>
              <p class="text-xs text-slate-500">SEO &amp; Digital Tools Expert</p>
            </div>
          </div>

          <div class="flex gap-2">
            <button
              class="p-2 text-slate-400 hover:text-indigo-600 transition-colors"
              aria-label="Share on X"
              data-share="twitter"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </button>
            <button
              class="p-2 text-slate-400 hover:text-indigo-600 transition-colors"
              aria-label="Share on LinkedIn"
              data-share="linkedin"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
              </svg>
            </button>
            <button
              class="p-2 text-slate-400 hover:text-indigo-600 transition-colors"
              aria-label="Share on Facebook"
              data-share="facebook"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      {relatedTools.length > 0 && (
        <RelatedTools tools={relatedTools} locale={locale} />
      )}

      {relatedPosts.length > 0 && (
        <section class="mt-12 border-t border-slate-200 pt-8">
          <h2 class="text-xl font-bold text-slate-900 mb-4">Related Articles</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {relatedPosts.map((post) => (
              <a
                href={post.href}
                class="block p-4 border border-slate-200 rounded-xl hover:border-indigo-300 hover:shadow-md transition-all"
              >
                <h3 class="font-semibold text-slate-900 hover:text-indigo-600 transition-colors">
                  {post.title}
                </h3>
              </a>
            ))}
          </div>
        </section>
      )}

      <AdSenseBlock slotId="ARTICLE_BOTTOM" format="horizontal" className="mt-8" />
    </div>
  </div>
</Base>
